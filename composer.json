{
    "name": "organization/employee-assessment-system",
    "description": "Enterprise Employee Assessment and Testing System in PHP 8.2+ & MySQL 8.0.16+",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-dom": "*",
        "ext-zip": "*",
        "vlucas/phpdotenv": "^5.6",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^2.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/HelperFunctions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
