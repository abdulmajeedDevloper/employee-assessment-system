APP_ENV=production
APP_URL=http://localhost/employee-assessment-system/public
APP_TIMEZONE=Asia/Riyadh
PHP_MIN_VERSION=8.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employee_assessment
DB_USERNAME=root
DB_PASSWORD=

SECURITY_HMAC_SECRET=change_this_to_a_random_64_hex_char_secret_key
SECURITY_AES_KEY=change_this_to_a_32_byte_hex_aes_key
RATE_LIMIT_SECRET=change_this_to_a_random_64_hex_char_secret_key

RATE_LIMIT_MAX_FAILED_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15
RATE_LIMIT_RETENTION_DAYS=30

FINALIZE_EXPIRED_BATCH_SIZE=50
FINALIZE_EXPIRED_LOCK_SECONDS=300

MAIL_QUEUE_BATCH_SIZE=25
MAIL_QUEUE_MAX_ATTEMPTS=5

TEMP_EXPORT_RETENTION_HOURS=24

EMPLOYEE_SESSION_IDLE_MINUTES=30
EMPLOYEE_SESSION_ABSOLUTE_HOURS=8

# Secure question/option images (path is relative to project root unless absolute)
QUESTION_MEDIA_STORAGE_PATH=storage/uploads
QUESTION_MEDIA_MAX_BYTES=5242880
QUESTION_MEDIA_MAX_DIMENSION=5000
QUESTION_MEDIA_MAX_PIXELS=20000000
MEDIA_DELETION_BATCH_SIZE=25

# Protected report exports
REPORT_EXPORT_STORAGE_PATH=storage/exports
REPORT_DOWNLOAD_TOKEN_TTL_SECONDS=600
REPORT_XLSX_MAX_ROWS=10000
REPORT_PDF_MAX_ROWS=1000
REPORT_EXPORT_CLEANUP_BATCH_SIZE=500

# Database-backed completion email notifications
MAIL_NOTIFICATIONS_ENABLED=true
ASSESSMENT_COMPLETION_RECIPIENTS=hr@example.com
NOTIFICATION_REQUIRED_TEST_CODES=IQ_TEST,ENG_TEST
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Employee Assessment System"
MAIL_TIMEOUT_SECONDS=20
MAIL_QUEUE_STALE_LOCK_MINUTES=15
